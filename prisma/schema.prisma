generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())

  surveys      Survey[]     @relation("UserSurveys")
  submissions  Submission[]
}

model Survey {
  id          String       @id @default(uuid())
  authorId    String
  title       String
  description String?
  status      SurveyStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author      User         @relation("UserSurveys", fields: [authorId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions Submission[]

  @@index([authorId])
}

model Question {
  id        String       @id @default(uuid())
  surveyId  String
  type      QuestionType
  text      String
  order     Int
  createdAt DateTime     @default(now())

  survey    Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options   Option[]
  answers   Answer[]

  @@unique([surveyId, order])
  @@index([surveyId])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  text       String
  order      Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerOpts AnswerOption[]

  @@unique([questionId, order])
  @@index([questionId])
}

model Submission {
  id           String   @id @default(uuid())
  surveyId     String
  respondentId String
  createdAt    DateTime @default(now())

  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondent   User     @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@unique([surveyId, respondentId])
  @@index([respondentId])
}

model Answer {
  id           String   @id @default(uuid())
  submissionId String
  questionId   String
  textValue    String?

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  options      AnswerOption[]

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model AnswerOption {
  answerId String
  optionId String

  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option   Option @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
  @@index([optionId])
}
